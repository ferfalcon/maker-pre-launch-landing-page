---
interface Props {
	kind: 'passion' | 'financial' | 'lifestyle' | 'anywhere';
	title: string;
	body: string;
	illustration: string;
	illustrationWidth: number;
	illustrationHeight: number;
}

const {
	kind,
	title,
	body,
	illustration,
	illustrationWidth,
	illustrationHeight,
} = Astro.props;
---

<article class:list={['benefit-card', `benefit-card--${kind}`]}>
	<div class="benefit-card__icon" aria-hidden="true">
		<img
			class="benefit-card__illustration"
			src={illustration}
			alt=""
			width={illustrationWidth}
			height={illustrationHeight}
		/>
	</div>

	<div class="benefit-card__copy">
		<h2 class="benefit-card__title">{title}</h2>
		<p class="benefit-card__body">{body}</p>
	</div>
</article>

<style>
	.benefit-card {
		display: flex;
		min-width: 0;
		width: 100%;
		flex-direction: column;
		align-items: center;
		gap: var(--space-32);
	}

	.benefit-card__icon {
		display: flex;
		width: 120px;
		height: 120px;
		flex: none;
		align-items: center;
		justify-content: center;
		border-radius: var(--space-32);
		background: var(--color-blue-800);
	}

	.benefit-card__illustration {
		max-width: none;
		flex: none;
		height: auto;
	}

	.benefit-card--passion .benefit-card__illustration {
		width: 70px;
	}

	.benefit-card--financial .benefit-card__illustration {
		width: 65px;
	}

	.benefit-card--lifestyle .benefit-card__illustration {
		width: 60px;
	}

	.benefit-card--anywhere .benefit-card__illustration {
		width: 70px;
	}

	.benefit-card__copy {
		display: flex;
		min-width: 0;
		width: 100%;
		max-width: 343px;
		flex-direction: column;
		gap: var(--space-12);
		text-align: center;
	}

	.benefit-card--financial .benefit-card__copy {
		max-width: 315px;
	}

	.benefit-card__title,
	.benefit-card__body {
		width: 100%;
		margin: 0;
	}

	.benefit-card__title {
		color: var(--color-neutral-0);
		font-size: var(--font-heading-small);
		font-weight: var(--font-weight-extra-bold);
		line-height: var(--line-heading);
	}

	.benefit-card__body {
		color: var(--color-neutral-400);
		font-size: var(--font-body-medium);
		font-weight: var(--font-weight-medium);
		line-height: var(--line-body);
	}

	@media (min-width: 40rem) {
		.benefit-card {
			flex-direction: row;
			align-items: center;
			gap: var(--space-48);
		}

		.benefit-card__copy {
			max-width: 344px;
			gap: var(--space-16);
			text-align: left;
		}

		.benefit-card--financial .benefit-card__copy {
			max-width: 315px;
		}
	}

	@media (min-width: 75rem) {
		.benefit-card {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-48);
		}

		.benefit-card__icon {
			width: 160px;
			height: 164px;
			border-radius: var(--space-48);
		}

		.benefit-card--passion .benefit-card__illustration {
			width: 88px;
		}

		.benefit-card--financial .benefit-card__illustration {
			width: 74px;
		}

		.benefit-card--lifestyle .benefit-card__illustration {
			width: 80px;
		}

		.benefit-card--anywhere .benefit-card__illustration {
			width: 104px;
		}

		.benefit-card__copy,
		.benefit-card--financial .benefit-card__copy {
			max-width: 255px;
			gap: var(--space-24);
			text-align: left;
		}
	}
</style>
