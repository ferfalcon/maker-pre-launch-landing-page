{
  "name": "@ferfalcon/design-workflow",
  "version": "0.3.0",
  "description": "Dependency-free CLI and workflow toolkit for evidence-driven design-to-implementation projects.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "design-workflow": "./cli/design-workflow.mjs"
  },
  "files": [
    "AGENTS.md",
    "AGENTS-instructions.md",
    "AGENTS-PROMPT-Figma-file-preparation.md",
    "AI-project-settings.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "QUICKSTART.md",
    "README.md",
    "cli",
    "examples",
    "guidelines",
    "prompts",
    "schemas",
    "scripts",
    "source-adapters",
    "templates",
    "tests",
    "workflow"
  ],
  "scripts": {
    "prepack": "node scripts/package-toolkit-provenance.mjs write",
    "postpack": "node scripts/package-toolkit-provenance.mjs clean",
    "validate": "node scripts/run-validation-suite.mjs",
    "test:runner": "node scripts/test-validation-runner.mjs",
    "test:path-safety": "node scripts/test-path-safety.mjs",
    "test:release": "node scripts/test-release-metadata.mjs",
    "test:figma-preparation": "node scripts/test-figma-preparation-authority.mjs",
    "test:agent-bootstrap": "node scripts/test-agent-bootstrap-authority.mjs",
    "test:entrypoints": "node scripts/test-entrypoint-authority.mjs",
    "test:layering": "node scripts/test-cli-layering.mjs",
    "test:validation-architecture": "node scripts/test-workflow-validation-architecture.mjs",
    "test:records": "node scripts/test-workflow-record.mjs",
    "test:invariants": "node scripts/test-canonical-invariants.mjs",
    "test:gates": "node scripts/test-stage-gates.mjs",
    "test:state": "node scripts/test-generated-state.mjs",
    "test:agent-projection": "node scripts/test-agent-projection.mjs",
    "test:concurrency": "node scripts/test-record-concurrency.mjs",
    "test:render": "node scripts/test-artifact-renderer.mjs",
    "test:task-phases": "node scripts/test-task-phases.mjs",
    "test:orchestration": "node scripts/test-orchestration.mjs",
    "test:toolkit": "node scripts/test-toolkit-source.mjs",
    "test:packed-install": "node scripts/test-packed-install.mjs",
    "test:integrity": "node scripts/test-subject-integrity.mjs",
    "test:agent-context": "node scripts/test-agent-context.mjs",
    "test:command-ownership": "node scripts/test-command-ownership.mjs",
    "test:git-policy": "node scripts/test-git-worktree-policy.mjs",
    "test:repository": "node scripts/test-repository-portability.mjs",
    "test:workspace": "node scripts/test-workspace-resolution.mjs",
    "test:checkpoints": "node scripts/test-task-start-checkpoints.mjs",
    "test:replanning": "node scripts/test-replanning-transitions.mjs",
    "test:cli": "node scripts/test-cli.mjs",
    "test:lineage": "node scripts/test-sequential-task-lineage.mjs",
    "test:github-remote": "node scripts/test-github-remote-command.mjs && node scripts/test-github-remote-authorization.mjs && node scripts/test-github-remote-paths.mjs",
    "test:action-pinning": "node scripts/test-github-actions-pinning.mjs",
    "test:package": "node scripts/test-package-manifest.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
